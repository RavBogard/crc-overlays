# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example is names and placeholders only — no value from any real environment.
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

*.tsbuildinfo
__pycache__/

# The Claude desktop app's drop folder. A Cowork session writes its deliverables here
# (handoffs, import sheets, converted deck files); the copies that belong to the repo are
# committed under docs/planning/ and work/. Untracked files block the release script, so
# this folder is named rather than left to trip it.
/Claude outputs/
