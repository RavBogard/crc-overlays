{
  "name": "crc-overlays",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev --port 5175",
    "build": "next build",
    "start": "next start --port 5175",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "npm run test:ts && npm run test:mjs",
    "test:ts": "node node_modules/tsx/dist/cli.mjs --test tests/*.test.ts app/author/*.test.ts",
    "test:mjs": "node --test \"tests/*.test.mjs\"",
    "test:py": "python -m unittest tests.test_cue_sources -v",
    "test:renderer": "node --test --experimental-strip-types tests/player.test.ts",
    "test:mcp": "node node_modules/tsx/dist/cli.mjs --test tests/oauth*.test.ts tests/mcp*.test.ts",
    "rehearsal": "node node_modules/tsx/dist/cli.mjs scripts/rehearsal.mjs",
    "rehearsal:check": "node node_modules/tsx/dist/cli.mjs scripts/check-rehearsal.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@shadcn/react": "^0.3.0",
    "@sparticuz/chromium": "153.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "playwright-core": "1.63.0",
    "qrcode-generator": "1.4.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.0"
  },
