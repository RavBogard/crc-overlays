{
  "name": "crc-overlays",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev --port 5175",
    "build": "next build",
    "start": "next start --port 5175",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "npm run test:ts && npm run test:mjs",
    "test:ts": "node node_modules/tsx/dist/cli.mjs --test tests/*.test.ts app/author/*.test.ts",
    "test:mjs": "node --test \"tests/*.test.mjs\"",
    "test:py": "python -m unittest discover -s tests -p \"test_*.py\" -t . -v",
    "test:renderer": "node --test --experimental-strip-types tests/player.test.ts",
    "audit:companion-rehearsal": "node scripts/audit-companion-rehearsal.mjs",
    "test:mcp": "node node_modules/tsx/dist/cli.mjs --test tests/oauth*.test.ts tests/mcp*.test.ts",
    "rehearsal": "node node_modules/tsx/dist/cli.mjs scripts/rehearsal.mjs",
    "rehearsal:check": "node node_modules/tsx/dist/cli.mjs scripts/check-rehearsal.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@sparticuz/chromium": "153.0.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.5",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "playwright-core": "1.63.0",
    "qrcode-generator": "1.4.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "ws": "8.21.3"
  },
  "type": "module"
}
