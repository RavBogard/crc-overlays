{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centralreform.org/schemas/crc-overlay-catalog-v1.json",
  "title": "CRC generated overlay cue catalog",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "layout", "texts", "animations", "duration", "provenance"],
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "name": { "type": "string", "minLength": 1 },
      "layout": { "enum": ["bottom", "left", "right"] },
      "texts": {
        "type": "object",
        "required": ["textTitle"],
        "additionalProperties": { "type": "string" },
        "properties": {
          "textTitle": { "type": "string", "minLength": 1 },
          "accentTextTitle": { "type": "string" },
          "textMain": { "type": "string" },
          "textMainheb": { "type": "string" },
          "textMainEng": { "type": "string" }
        }
      },
      "animations": { "type": "array", "items": { "type": "object" } },
      "duration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["In", "Out"],
        "properties": { "In": { "type": "number" }, "Out": { "type": "number" } }
      },
      "presentation": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "hebrewFontSize": { "type": "integer", "minimum": 24, "maximum": 52 },
          "transliterationFontSize": { "type": "integer", "minimum": 20, "maximum": 48 },
          "translationFontSize": { "type": "integer", "minimum": 20, "maximum": 48 },
          "titleFontSize": { "type": "integer", "minimum": 20, "maximum": 42 },
          "hebrewLineHeight": { "type": "number", "minimum": 0.9, "maximum": 2 },
          "transliterationLineHeight": { "type": "number", "minimum": 0.9, "maximum": 2 },
          "translationLineHeight": { "type": "number", "minimum": 0.9, "maximum": 2 },
          "titleLineHeight": { "type": "number", "minimum": 0.9, "maximum": 2 },
          "hebrewLetterSpacing": { "type": "number", "minimum": -2, "maximum": 8 },
          "transliterationLetterSpacing": { "type": "number", "minimum": -2, "maximum": 8 },
          "translationLetterSpacing": { "type": "number", "minimum": -2, "maximum": 8 },
          "titleLetterSpacing": { "type": "number", "minimum": -2, "maximum": 8 },
          "hebrewFontFamily": { "enum": ["noto-sans", "david-libre", "frank-ruhl-libre"] },
          "verticalAlignment": { "enum": ["top", "center", "bottom"] },
          "legacyTitleWatermark": { "type": "boolean" },
          "keepHyphenatedWords": { "type": "boolean" },
          "largePrint": { "type": "boolean" },
          "alignment": { "enum": ["start", "center"] },
          "lineSpacing": { "enum": ["compact", "spacious"] },
          "latinLineBreaks": { "enum": ["preserve", "paragraphs", "phrases"] },
          "imageAssetId": { "type": "string", "pattern": "^asset_[a-f0-9]{64}$" }
        }
      },
      "contentRows": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["he", "tr", "en"],
          "properties": {
            "he": { "type": "string", "minLength": 1 },
            "tr": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          }
        }
      },
      "aliasOf": { "type": "string", "format": "uuid" },
      "hidden": { "type": "boolean" },
      "provenance": {
        "type": "object",
        "required": ["kind", "mappingSchemaVersion", "archive"],
        "properties": {
          "kind": { "const": "generated legacy CRC source adapter" },
          "mappingSchemaVersion": { "const": 1 },
          "archive": { "type": "object" },
          "liturgy": { "type": "object" },
          "copy": { "type": "string" }
        }
      }
    }
  }
}
