          {
           "type": "object",
           "properties": {
            "mode": {
             "type": "string",
             "const": "original-en"
            },
            "englishGroups": {
             "minItems": 1,
             "maxItems": 24,
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
               },
               "blockIds": {
                "minItems": 1,
                "maxItems": 48,
                "type": "array",
                "items": {
                 "type": "string",
                 "minLength": 1,
                 "maxLength": 220
                }
               }
              },
              "required": [
               "sourceId",
               "blockIds"
              ],
              "additionalProperties": false
             }
            }
           },
           "required": [
            "mode",
            "englishGroups"
           ],
           "additionalProperties": false
          },
          {
           "type": "object",
           "properties": {
            "mode": {
             "type": "string",
             "const": "source-en"
            },
            "englishGroups": {
             "minItems": 1,
             "maxItems": 24,
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
               },
               "blockIds": {
                "minItems": 1,
                "maxItems": 48,
                "type": "array",
                "items": {
