     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "after": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    }
   }
  },
  "annotations": {
   "readOnlyHint": true
  }
 },
