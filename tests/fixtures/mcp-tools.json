[
 {
  "name": "archive_draft",
  "description": "Archive a standalone draft without changing its published output.",
  "inputSchema": {
   "type": "object",
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "draftId": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    },
    "expectedVersion": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    }
   },
   "required": [
    "draftId",
    "expectedVersion"
   ]
  },
  "annotations": {
   "readOnlyHint": false,
   "idempotentHint": true
  }
 },
 {
  "name": "archive_draft_set",
  "description": "Atomically archive a complete multipart draft set without changing published output.",
  "inputSchema": {
   "type": "object",
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "setId": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    },
    "expectedDraftIds": {
     "minItems": 1,
     "maxItems": 200,
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
     }
    }
   },
   "required": [
    "setId",
    "expectedDraftIds"
   ]
  },
  "annotations": {
   "readOnlyHint": false,
   "idempotentHint": true
  }
 },
 {
  "name": "create_draft",
  "description": "Create a source-reference draft with a new stable ID. The corner layout is a small card for a line or two in the bottom-right corner; it takes a lower-third (bottom) template.",
  "inputSchema": {
   "type": "object",
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 80
    },
    "title": {
     "type": "string",
     "minLength": 1,
     "maxLength": 100
    },
    "accentTitle": {
     "type": "string",
     "maxLength": 60
    },
    "layout": {
     "type": "string",
     "enum": [
      "left",
      "bottom",
      "right",
      "corner"
     ]
    },
    "templateCueId": {
     "type": "string",
     "minLength": 1,
     "maxLength": 80
    },
    "content": {
     "anyOf": [
      {
       "oneOf": [
        {
         "type": "object",
         "properties": {
          "mode": {
           "type": "string",
           "const": "bilingual"
          },
          "hebrewGroups": {
           "minItems": 1,
           "maxItems": 24,
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "sourceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
             },
             "blockIds": {
              "minItems": 1,
              "maxItems": 48,
              "type": "array",
              "items": {
               "type": "string",
               "minLength": 1,
               "maxLength": 220
              }
             }
            },
            "required": [
             "sourceId",
             "blockIds"
            ],
            "additionalProperties": false
           }
          },
          "transliterationGroups": {
           "minItems": 1,
           "maxItems": 24,
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "sourceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
             },
             "blockIds": {
              "minItems": 1,
              "maxItems": 48,
              "type": "array",
              "items": {
               "type": "string",
               "minLength": 1,
               "maxLength": 220
              }
             }
            },
            "required": [
             "sourceId",
             "blockIds"
            ],
            "additionalProperties": false
           }
          },
          "includeTranslation": {
           "type": "boolean"
          },
          "layers": {
           "minItems": 1,
           "maxItems": 3,
           "type": "array",
           "items": {
            "type": "string",
            "enum": [
             "he",
             "tr",
             "en"
            ]
           }
          },
          "arrangement": {
           "type": "string",
           "enum": [
            "together",
            "blocks"
           ]
          },
          "rowOrder": {
           "minItems": 3,
           "maxItems": 3,
           "type": "array",
           "items": {
            "type": "string",
            "enum": [
             "he",
             "tr",
             "en"
            ]
           },
           "description": "Order the Hebrew (he), transliteration (tr) and translation (en) layers stack in on a left or right panel, in both arrangements. Default he, tr, en, which is stored as absent; a lower third ignores it."
          }
         },
         "required": [
          "mode",
          "hebrewGroups",
          "transliterationGroups"
         ],
         "additionalProperties": false
        },
        {
         "type": "object",
         "properties": {
          "mode": {
           "type": "string",
           "const": "original-en"
          },
          "englishGroups": {
           "minItems": 1,
           "maxItems": 24,
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "sourceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
             },
             "blockIds": {
              "minItems": 1,
              "maxItems": 48,
              "type": "array",
              "items": {
               "type": "string",
               "minLength": 1,
               "maxLength": 220
              }
             }
            },
            "required": [
             "sourceId",
             "blockIds"
            ],
            "additionalProperties": false
           }
          }
         },
         "required": [
          "mode",
          "englishGroups"
         ],
         "additionalProperties": false
        },
        {
         "type": "object",
         "properties": {
          "mode": {
           "type": "string",
           "const": "source-en"
          },
          "englishGroups": {
           "minItems": 1,
           "maxItems": 24,
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "sourceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
             },
             "blockIds": {
              "minItems": 1,
              "maxItems": 48,
              "type": "array",
              "items": {
               "type": "string",
               "minLength": 1,
               "maxLength": 220
              }
             }
            },
            "required": [
             "sourceId",
             "blockIds"
            ],
            "additionalProperties": false
           }
          }
         },
         "required": [
          "mode",
          "englishGroups"
         ],
         "additionalProperties": false
        }
       ]
      },
      {
       "type": "object",
       "properties": {
        "mode": {
         "type": "string",
         "const": "local-variant"
        },
        "label": {
         "type": "string",
         "minLength": 1,
         "maxLength": 80
        },
        "reason": {
         "type": "string",
         "minLength": 1,
         "maxLength": 500
        },
        "base": {
         "oneOf": [
          {
           "type": "object",
           "properties": {
            "mode": {
             "type": "string",
             "const": "bilingual"
            },
            "hebrewGroups": {
             "minItems": 1,
             "maxItems": 24,
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
               },
               "blockIds": {
                "minItems": 1,
                "maxItems": 48,
