               },
               "blockIds": {
                "minItems": 1,
                "maxItems": 48,
                "type": "array",
                "items": {
                 "type": "string",
                 "minLength": 1,
                 "maxLength": 220
                }
               }
              },
              "required": [
               "sourceId",
               "blockIds"
              ],
              "additionalProperties": false
             }
            },
            "includeTranslation": {
             "type": "boolean"
            },
            "layers": {
             "minItems": 1,
             "maxItems": 3,
             "type": "array",
             "items": {
              "type": "string",
              "enum": [
               "he",
               "tr",
               "en"
              ]
             }
            },
            "arrangement": {
             "type": "string",
             "enum": [
              "together",
              "blocks"
             ]
            },
            "rowOrder": {
             "minItems": 3,
             "maxItems": 3,
             "type": "array",
             "items": {
              "type": "string",
