# Every environment variable this repository reads, with a placeholder value.
#
# .gitignore excludes .env* outright, so no real environment file has ever been committed and
# none should be. This file is the exception (see the `!.env.example` line beside that rule) and
# it holds names and shapes only: no key, no connection string, no token, not even a redacted
# one. If you are about to paste a real value here, stop.
#
# Two congregations run the same code from one deployment each. "CRC" is Central Reform
# Congregation (overlays.centralreform.org); "TBI" is Temple B'nai Israel, Kalamazoo
# (overlays.templebnaiisrael.com). Where a variable belongs to one workspace only, the comment
# says so. docs/WORKSPACE-DEPLOYMENT.md is the longer explanation of each.
#
# Copy to .env.local for local work. The web app and the scripts read these; the relay worker's
# own variables live in relay/wrangler.jsonc and its secret is set with wrangler, not here.

# ---------------------------------------------------------------------------
# Identity and addresses — required on both workspaces
# ---------------------------------------------------------------------------

# Which congregation this deployment is. Everything workspace-specific keys off it.
# CRC uses `crc`; TBI uses `temple-bnai-israel-kalamazoo`.
WORKSPACE_ID=crc

# This workspace's own primary https origin. Used wherever no request exists — the server fit
# check, links in MCP results — and, if unset, Google sign-in stays off rather than sending
# someone to the other congregation's site.
PUBLIC_BASE_URL=https://overlays.centralreform.org

# Comma-separated https origins that also serve this workspace, beside PUBLIC_BASE_URL. In
# practice the Vercel hostname while the custom domain is primary. Each must also be registered
# with Google and allowed by the relay's ALLOWED_ORIGINS.
PUBLIC_ALTERNATE_ORIGINS=https://crc-overlays.vercel.app

# ---------------------------------------------------------------------------
# Database — required on both workspaces
# ---------------------------------------------------------------------------

# Neon PostgreSQL, this workspace's own database. Never shared between congregations.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Shared keys — required on both workspaces
# ---------------------------------------------------------------------------

# The operator's key for live control. It does not author and it does not read the cue log.
CONTROL_KEY=replace-me-with-a-long-random-string

# The graphics output's key: what the vMix or OBS browser source presents. Read-only.
OUTPUT_KEY=replace-me-with-a-long-random-string

# One-time key that seeds the first administrator. Remove once a real owner account exists.
ACCESS_BOOTSTRAP_KEY=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# Relay — required on both workspaces
# ---------------------------------------------------------------------------

# The Cloudflare worker that carries live commands and holds the cue log.
RELAY_URL=https://crc-live-relay.example.workers.dev

# Shared secret between the web app and the relay. The same value is set as the worker's secret.
RELAY_SECRET=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# Google sign-in — optional; without both, the workspace shows no Google button
# ---------------------------------------------------------------------------

GOOGLE_OAUTH_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me

# ---------------------------------------------------------------------------
# The public "now" endpoint — optional, and off
# ---------------------------------------------------------------------------

# Set to 1 to serve GET /api/now, the credential-free reading of which unit is on screen.
# Unset, it answers 404. It stays unset on both congregations: 142 of the 732 units in
# content/siddur-library.json come from draft books, and the endpoint would publish a draft
# book slug and folio on a public surface. Do not turn this on without Daniel asking.
# OVERLAYS_PUBLIC_NOW=1

# ---------------------------------------------------------------------------
# centralreform.live import — CRC only, optional
# ---------------------------------------------------------------------------

# With the token below, enables "Import from centralreform.live" and the
# prepare_service_from_setlist MCP tool.
CRC_LIVE_BASE_URL=https://www.centralreform.live

# A setlist_reader bearer minted on centralreform.live: read-only, three operations, revocable
# there. Sensitive; never copied through chat.
CRC_LIVE_READ_TOKEN=replace-me

# ---------------------------------------------------------------------------
# The shared library — CRC exports, TBI imports (R-0919-audit-7)
# ---------------------------------------------------------------------------

# TBI only: where TBI fetches the CRC library from.
CRC_SHARED_LIBRARY_URL=https://overlays.centralreform.org/api/shared-library

# TBI only: the key TBI presents to that endpoint. Must differ from CONTROL_KEY, OUTPUT_KEY and
# ACCESS_BOOTSTRAP_KEY; the import refuses if it matches any of them.
SHARED_LIBRARY_IMPORT_KEY=replace-me-with-a-long-random-string

# CRC only: the key CRC requires on its shared-library endpoint.
SHARED_LIBRARY_EXPORT_KEY=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# Workspace presentation — optional, per workspace
# ---------------------------------------------------------------------------

# `1` or `true` turns on book faces in the library browser. Default off.
WORKSPACE_BOOK_FACES=

# Where this workspace's Companion module and Stream Deck page exports are served from, shown on
# the setup page. A comma-separated list for the pages.
WORKSPACE_COMPANION_MODULE_PATH=/downloads/crc-overlays-1.5.0.tgz
WORKSPACE_COMPANION_PAGE_PATHS=/downloads/crc-morning-page-1.companionconfig,/downloads/crc-morning-page-2.companionconfig

# ---------------------------------------------------------------------------
# The server fit check — optional
# ---------------------------------------------------------------------------

# playwright-core launches a locally installed Chrome; this names it when the default search
# does not find one. On Vercel the bundled @sparticuz/chromium is used instead.
PLAYWRIGHT_CHROMIUM_PATH=

# ---------------------------------------------------------------------------
# The relay worker's own variables — set in relay/wrangler.jsonc, not here
# ---------------------------------------------------------------------------
#
#   WORKSPACE        which congregation the worker serves
#   LIVE_ROOM        the Durable Object binding that holds live state and the cue log
#   ALLOWED_ORIGINS  comma-separated origins allowed to reach the worker; must include every
#                    origin in PUBLIC_BASE_URL and PUBLIC_ALTERNATE_ORIGINS
#   RELAY_SECRET     set with `wrangler secret put`, never in the jsonc file

# ---------------------------------------------------------------------------
# Rehearsal and tests — never set in production
# ---------------------------------------------------------------------------

# Routes authoring at an isolated rehearsal schema instead of the live one.
CRC_AUTHORING_REHEARSAL=
CRC_REHEARSAL_RELAY_PORT=

# Pins the isolated rehearsal schema. Always verify SELECT current_schema() before a test
# mutation; this is the guard that keeps a rehearsal off live data.
PGOPTIONS=-c search_path=crc_authoring_rehearsal

# Databases the suites may write to. Never a production connection string.
TEST_DATABASE_URL=postgres://user:password@host/dbname_test?sslmode=require
RECOVERY_REHEARSAL_DATABASE_URL=

# Opt-in switches for the suites that need a real PostgreSQL rather than a fake.
SOURCE_REVIEW_POSTGRES_TEST=
ACCESS_POSTGRES_TEST=

# The device-pairing test's shared secret.
CRC_PAIR_TEST_SECRET=

# Where the probe scripts point and where they read their keys from.
CRC_TEST_URL=http://localhost:5175
CRC_TEST_KEYS=work/keys.json

# scripts/check-live-site.mts probes this origin. Required when that script is run; it refuses
# rather than guessing a default.
SITE_URL=http://127.0.0.1:5180

# A checkout of the shireishabbat source repository. scripts/build-siddur-library.py reads
# SIDDUR_SOURCE_ROOT; the authoring-pack test reads CRC_SHIREISHABBAT_ROOT and skips when the
# checkout is absent, which is always true on a CI runner.
SIDDUR_SOURCE_ROOT=../shireishabbat
CRC_SHIREISHABBAT_ROOT=C:/Users/dsbog/shireishabbat
